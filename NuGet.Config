<?xml version="1.0" encoding="utf-8"?>
<!--
//summary//
Configures trusted package sources for dependency restoration.
//summary//
-->
<!-- Start Of File -->
<!-- Use the public package feed without inheriting machine-specific private sources. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <config>
    <add key="maxHttpRequestsPerSource" value="4" />
  </config>
</configuration>
<!-- End Of File -->
